# vinted-tracker configuration. Copy to .env and fill in. NEVER commit .env.

# --- What to track -------------------------------------------------------
# Vinted market / TLD: fr, de, es, it, us, ... (any supported market)
MARKET=fr
# Free-text query sent to the catalog. Usually the brand you want.
SEARCH_QUERY=havok
# Restrict results to items whose brand_title equals this (case-insensitive).
# Strongly recommended: a bare text search also returns look-alikes (e.g.
# "havok" also matches Marvel's X-Men Havok comics/figures). Leave empty to
# track every item returned by SEARCH_QUERY.
BRAND_FILTER=havok
# Human label used for the Discord username and the dashboard title.
TRACKER_NAME=Havok Tracker

# --- Where to send alerts ------------------------------------------------
# Discord channel webhook URL (webhooks can only post; success = HTTP 204).
DISCORD_WEBHOOK_URL=

# --- Polling / paging ----------------------------------------------------
# Seconds between polls.
POLL_INTERVAL=300
# Results per page (Vinted caps ~96).
PER_PAGE=96
# How many pages of newest_first results to scan (PER_PAGE * PAGES items).
PAGES=2
# Mark an item sold only after it has been missing this many consecutive
# non-empty polls AND its own item page no longer shows a live listing.
SOLD_AFTER_MISSING=2

# --- Networking / logging ------------------------------------------------
# Optional proxy URL (http://user:pass@host:port). Empty = direct connection.
PROXY=
# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# Set to 1 to log alerts instead of POSTing them (local testing).
#DRY_RUN=1

# --- Overrides (advanced; the defaults are fine for a single instance) ---
#STATE_FILE=state/seen.json
#COOKIES_DIR=state/cookies
#UI_HOST=127.0.0.1
#UI_PORT=3110
